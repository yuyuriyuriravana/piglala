DISCORD_BOT_TOKEN=your_bot_token_here

# FFLogs OAuth credentials — create a client at https://www.fflogs.com/api/clients/
FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=

# Directory containing required Go template files for Discord messages.
MESSAGE_TEMPLATE_DIR=templates

# SQLite database path for watched players and recorded best parses.
STORE_DB_PATH=store.sqlite3

# How often to poll FFLogs for new clears (default: 30)
POLL_INTERVAL_MINUTES=30

# Public FFXIV item and market APIs. The item catalog is cached in STORE_DB_PATH.
XIVAPI_BASE_URL=https://v2.xivapi.com/api
UNIVERSALIS_BASE_URL=https://universalis.app/api/v2
ITEM_CATALOG_REFRESH_HOURS=168
PRICE_HISTORY_ENTRIES=20

# OpenAI-compatible local llama-server used for short response notes and price analysis.
LLAMA_SERVER_URL=http://127.0.0.1:8080/v1/chat/completions
LLAMA_MAX_TOKENS=512
LLAMA_TEMPERATURE=0.7

# Local Lavalink node used for DAVE-compatible Discord voice playback.
LAVALINK_ADDRESS=127.0.0.1:2333
LAVALINK_PASSWORD=youshallnotpass
LAVALINK_SECURE=false
