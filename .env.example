DISCORD_BOT_TOKEN=your_bot_token_here

# FFLogs OAuth credentials — create a client at https://www.fflogs.com/api/clients/
FFLOGS_CLIENT_ID=
FFLOGS_CLIENT_SECRET=

# Directory containing required Go template files for Discord messages.
MESSAGE_TEMPLATE_DIR=templates

# SQLite database path for watched players and recorded best parses.
STORE_DB_PATH=store.sqlite3

# How often to poll FFLogs for new clears (default: 30)
POLL_INTERVAL_MINUTES=30
